{
  "name": "pixel-desktop",
  "version": "2.2.3",
  "author": "Goutham Kumar A",
  "description": "Pixel Focus - The Ultimate App to Lock In",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pixel.app",
    "productName": "Pixel Focus",
    "copyright": "Copyright © 2026 Goutham Kumar A",
    "directories": {
      "output": "release",
      "buildResources": "../logo"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "electron-web",
        "to": "electron-web"
      },
      {
        "from": "build",
        "to": "build"
      },
      {
        "from": "../logo",
        "to": "logo"
      }
    ],
    "win": {
      "icon": "../logo/logo_dark.ico",
      "target": [
        {
          "target": "appx",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "appx": {
      "applicationId": "PixelFocus",
      "identityName": "PixelInc.PixelFocus",
      "publisher": "CN=38A30AA3-1F11-405F-8B95-4AE3C413E3A4",
      "publisherDisplayName": "Pixel_Inc",
      "backgroundColor": "transparent"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "../logo/logo_dark.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixel"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  }
}